{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2021",
		"lib": ["es2021"],
		"moduleResolution": "node",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"outDir": "lib",
		"rootDir": "src"
	},
	"include": ["src"]
}
