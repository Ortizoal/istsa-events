# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Verified "from" address, e.g. "ISTSA Events <events@yourdomain.com>"
MAIL_FROM=ISTSA Events <onboarding@resend.dev>

# Comma-separated emails auto-promoted to admin on first sign-in
SUPER_ADMIN_EMAILS=

# Public base URL of the deployed portal (used for ticket links)
APP_URL=https://your-istsa-portal.vercel.app
